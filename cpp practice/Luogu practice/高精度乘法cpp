#include <iostream>
#include <string>
using namespace std;

#define MAXN 5050
int a[MAXN], b[MAXN], c[MAXN];

int main()
{
    string A, B;
    cin >> A >> B;

    int lena = A.length(), lenb = B.length();
    for (int i = 0; i < lena; i++)
        a[lena - i] = A[i] - '0';
    for (int i = 0; i < lenb; i++)
        b[lenb - i] = B[i] - '0';

    for (int i = 1; i <= lena; i++)
    {
        for (int j = 1; j <= lenb; j++)
        {
            c[i + j - 1] += a[i] * b[j];
        }
    }

    int lenc = lena + lenb;
    for (int i = 1; i <= lenc; i++)
    {
        c[i + 1] += c[i] / 10;
        c[i] %= 10;
    }

    while (lenc > 1 && c[lenc] == 0)
        lenc--;
    for (int i = lenc; i >= 1; i--)
        cout << c[i];
    return 0;
}