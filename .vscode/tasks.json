{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build cpp to output",
            "type": "process",
            "command": "C:\\MinGW\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\output\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "run cpp in terminal",
            "type": "shell",
            "dependsOn": "build cpp to output",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "& \"${fileDirname}\\output\\${fileBasenameNoExtension}.exe\"; Write-Host ''; Read-Host '按回车关闭'"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true
            }
        }
    ]
}